{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi", 
                "/MD",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "main.cpp",
                "init.cpp",
                "/I${workspaceFolder}\\Dependencies\\GLFW\\include",
                "/link",
                "/LIBPATH:${workspaceFolder}\\Dependencies\\GLFW\\lib-vc2026",
                "glfw3.lib", "opengl32.lib", "user32.lib", "gdi32.lib", "shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}